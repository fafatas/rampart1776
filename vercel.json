{
  "version": 2,
  "builds": [
    { "src": "api/ask.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "app/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ask", "dest": "/api/ask.js" },
    { "src": "/app", "dest": "/app/index.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
